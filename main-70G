# ============================================================
# HELPERS
# ============================================================

def get_number(value):
    """
    Convert SNMP values such as:

        52
        52.1
        "52.1"
        "52.1 C"

    to float.

    Returns None if the value is empty or non-numeric.
    """

    if value is None:
        return None

    value = str(value).strip()

    if value == "":
        return None

    match = re.search(
        r'-?\d+(?:\.\d+)?',
        value
    )

    if not match:
        return None

    try:
        return float(match.group())
    except ValueError:
        return None


def set_metric(metric, data, key):
    """
    Safely assign numeric SNMP value to Prometheus Gauge.
    """

    value = get_number(
        data.get(key)
    )

    if value is None:
        print(
            f"WARNING: {key} returned "
            f"{repr(data.get(key))}"
        )

        metric.set(float('nan'))

    else:
        metric.set(value)


# ============================================================
# FORTIGATE 70G
# ============================================================

async def run_Fortigate70G():

    snmpEngine = SnmpEngine()

    results = []

    try:

        # ----------------------------------------------------
        # FortiGate 70G
        # ----------------------------------------------------

        transport = await UdpTransportTarget.create(
            ("192.168.11.22", 161),
            timeout=5,
            retries=2
        )


        # ====================================================
        # SNMP OIDs
        # ====================================================

        oids = {

            # ------------------------------------------------
            # SYSTEM
            # ------------------------------------------------

            "Firmware Version":
                ObjectType(
                    ObjectIdentity(
                        "1.3.6.1.4.1.12356.101.4.1.1.0"
                    )
                ),

            "uptime, days":
                ObjectType(
                    ObjectIdentity(
                        "1.3.6.1.2.1.1.3.0"
                    )
                ),

            "cpu, %":
                ObjectType(
                    ObjectIdentity(
                        "1.3.6.1.4.1.12356.101.4.1.3.0"
                    )
                ),

            "memory, %":
                ObjectType(
                    ObjectIdentity(
                        "1.3.6.1.4.1.12356.101.4.1.4.0"
                    )
                ),

            "Low Memory Usage, %":
                ObjectType(
                    ObjectIdentity(
                        "1.3.6.1.4.1.12356.101.4.1.9.0"
                    )
                ),

            "Disk Usage, MB":
                ObjectType(
                    ObjectIdentity(
                        "1.3.6.1.4.1.12356.101.4.1.6.0"
                    )
                ),

            # Correct session OID
            "Sessions":
                ObjectType(
                    ObjectIdentity(
                        "1.3.6.1.4.1.12356.101.4.1.8.0"
                    )
                ),

            # Keep old metric name for compatibility.
            # On this exporter it reports same current
            # active session counter.
            "Active_Sessions":
                ObjectType(
                    ObjectIdentity(
                        "1.3.6.1.4.1.12356.101.4.1.8.0"
                    )
                ),


            # =================================================
            # FORTIGATE 70G TEMPERATURES
            # =================================================

            "TMP1_External_Temperature":
                ObjectType(
                    ObjectIdentity(
                        "1.3.6.1.4.1.12356.101.4.3.2.1.3.1"
                    )
                ),

            "TMP4_ON_DIE_Temperature":
                ObjectType(
                    ObjectIdentity(
                        "1.3.6.1.4.1.12356.101.4.3.2.1.3.2"
                    )
                ),

            "CPU_ON_DIE_Temperature":
                ObjectType(
                    ObjectIdentity(
                        "1.3.6.1.4.1.12356.101.4.3.2.1.3.3"
                    )
                ),

            # 88E1514_1
            "BCM_Switch_Temperature":
                ObjectType(
                    ObjectIdentity(
                        "1.3.6.1.4.1.12356.101.4.3.2.1.3.4"
                    )
                ),

            # 88E1514_2
            "B50185_Temperature":
                ObjectType(
                    ObjectIdentity(
                        "1.3.6.1.4.1.12356.101.4.3.2.1.3.5"
                    )
                ),

            # 88E1680
            "B50210_1_Temperature":
                ObjectType(
                    ObjectIdentity(
                        "1.3.6.1.4.1.12356.101.4.3.2.1.3.6"
                    )
                ),
        }


        # ====================================================
        # SNMP GET
        # ====================================================

        result = await get_cmd(
            snmpEngine,

            CommunityData(
                "SNMP-12",
                mpModel=1
            ),

            transport,

            ContextData(),

            *oids.values(),
        )


        errorIndication, errorStatus, errorIndex, varBinds = result


        # ====================================================
        # ERRORS
        # ====================================================

        if errorIndication:
            print(
                "SNMP Error:",
                errorIndication
            )

            return None

        elif errorStatus:

            print(
                "{} at {}".format(
                    errorStatus.prettyPrint(),
                    errorIndex
                    and varBinds[
                        int(errorIndex) - 1
                    ][0]
                    or "?"
                )
            )
            return None


        # ====================================================
        # RESULTS
        # ====================================================

        else:
            for key, varBind in zip(
                oids.keys(),
                varBinds
            ):

                value = (
                    varBind[1]
                    .prettyPrint()
                )


                # --------------------------------------------
                # UPTIME
                # TimeTicks = 1/100 second
                # --------------------------------------------

                if key == "uptime, days":

                    numeric_value = get_number(
                        value
                    )

                    if numeric_value is not None:

                        uptime_days = round(
                            numeric_value
                            / 8640000,
                            1
                        )

                        results.append(
                            f"{key} = "
                            f"{uptime_days}"
                        )

                    else:

                        results.append(
                            f"{key} = "
                        )


                else:

                    results.append(
                        f"{key} = {value}"
                    )


            data = dict(
                item.split(
                    " = ",
                    1
                )
                for item in results
            )


            # ------------------------------------------------
            # DEBUG OUTPUT
            # ------------------------------------------------

            print()
            print("=" * 70)
            print("FortiGate 70G - 192.168.11.22")
            print("=" * 70)

            for key, value in data.items():

                print(
                    f"{key:<35} {value}"
                )


            return data


    except Exception as error:
        print(
            f"SNMP collection error: "
            f"{error}"
        )
        return None
    finally:
        snmpEngine.close_dispatcher()


