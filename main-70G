# ============================================================
# HELPER
# ============================================================

def get_number(value):

    if value is None:
        return None

    value = str(value).strip()

    if not value:
        return None

    match = re.search(
        r"-?\d+(?:\.\d+)?",
        value
    )

    if not match:
        return None

    try:
        return float(
            match.group()
        )

    except ValueError:
        return None


# ============================================================
# SNMP COLLECTION
# ============================================================

async def collect_snmp():
    snmp_engine = SnmpEngine()

    try:

        transport = await UdpTransportTarget.create(
            (
                FORTIGATE_IP,
                SNMP_PORT
            ),
            timeout=5,
            retries=2
        )

        objects = [
            ObjectType(
                ObjectIdentity(oid)
            )
            for oid in OIDS.values()
        ]

        result = await get_cmd(
            snmp_engine,

            CommunityData(
                SNMP_COMMUNITY,
                mpModel=1
            ),

            transport,

            ContextData(),

            *objects
        )

        (
            error_indication,
            error_status,
            error_index,
            var_binds
        ) = result

        # ----------------------------------------------------
        # Check SNMP errors
        # ----------------------------------------------------

        if error_indication:
            raise RuntimeError(
                f"SNMP error: {error_indication}"
            )

        if error_status:
            raise RuntimeError(
                f"SNMP error: "
                f"{error_status.prettyPrint()}"
            )

        # ----------------------------------------------------
        # Convert response to dictionary
        # ----------------------------------------------------

        data = {}

        for key, var_bind in zip(
                OIDS.keys(),
                var_binds
        ):
            value = (
                var_bind[1]
                .prettyPrint()
            )

            data[key] = value

        # ====================================================
        # PRINT RESULTS
        # ====================================================

        print()
        print("=" * 70)
        print(
            f"FortiGate 70G "
            f"{FORTIGATE_IP}"
        )
        print("=" * 70)

        print(
            f"Firmware Version : "
            f"{data['firmware']}"
        )

        print(
            f"CPU Load         : "
            f"{data['cpu']} %"
        )

        print(
            f"Memory Load      : "
            f"{data['memory']} %"
        )

        print(
            f"Disk Usage       : "
            f"{data['disk_usage']} MB"
        )

        print(
            f"Disk Capacity    : "
            f"{data['disk_capacity']} MB"
        )

        print(
            f"Sessions         : "
            f"{data['sessions']}"
        )

        # ====================================================
        # UPTIME
        # ====================================================

        uptime_ticks = get_number(
            data["uptime"]
        )

        if uptime_ticks is not None:
            uptime_days = (
                    uptime_ticks
                    / 100
                    / 60
                    / 60
                    / 24
            )

            Uptime.set(
                uptime_days
            )

            print(
                f"Uptime           : "
                f"{uptime_days:.2f} days"
            )

        # ====================================================
        # BASIC METRICS
        # ====================================================

        Firmware.info({
            "version":
                data["firmware"]
        })

        value = get_number(
            data["cpu"]
        )

        if value is not None:
            CPU.set(value)

        value = get_number(
            data["memory"]
        )

        if value is not None:
            Memory.set(value)

        value = get_number(
            data["disk_usage"]
        )

        if value is not None:
            Disk_Usage.set(value)

        value = get_number(
            data["disk_capacity"]
        )

        if value is not None:
            Disk_Capacity.set(value)

        value = get_number(
            data["sessions"]
        )

        if value is not None:
            Sessions.set(value)

        # ====================================================
        # TEMPERATURES
        # ====================================================

        print()
        print("Temperatures")
        print("-" * 70)

        # TMP1 External
        value = get_number(
            data["tmp1_external"]
        )

        if value is not None:
            TMP1_External_Temperature.set(
                value
            )

            print(
                f"TMP1 External Temperature : "
                f"{value:.1f} C"
            )

        # TMP4
        value = get_number(
            data["tmp4"]
        )

        if value is not None:
            TMP4_Temperature.set(
                value
            )

            print(
                f"TMP4 Temperature          : "
                f"{value:.1f} C"
            )

        # CPU ON-DIE
        value = get_number(
            data["cpu_on_die"]
        )

        if value is not None:
            CPU_ON_DIE_Temperature.set(
                value
            )

            print(
                f"CPU ON-DIE Temperature    : "
                f"{value:.1f} C"
            )

        # 88E1514 #1
        value = get_number(
            data["88e1514_1"]
        )

        if value is not None:
            E88E1514_1_Temperature.set(
                value
            )

            print(
                f"88E1514_1 Temperature     : "
                f"{value:.1f} C"
            )

        # 88E1514 #2
        value = get_number(
            data["88e1514_2"]
        )

        if value is not None:
            E88E1514_2_Temperature.set(
                value
            )

            print(
                f"88E1514_2 Temperature     : "
                f"{value:.1f} C"
            )

        # 88E1680
        value = get_number(
            data["88e1680"]
        )

        if value is not None:
            E88E1680_Temperature.set(
                value
            )

            print(
                f"88E1680 Temperature       : "
                f"{value:.1f} C"
            )

        Fortigate_Up.set(1)


    except Exception as error:

        Fortigate_Up.set(0)

        print()
        print(
            f"ERROR: {error}"
        )


    finally:

        snmp_engine.close_dispatcher()


# ============================================================
# MAIN
# ============================================================

if __name__ == "__main__":

    start_http_server(
        PROMETHEUS_PORT
    )

    print(
        f"Prometheus exporter running:"
    )

    print(
        f"http://0.0.0.0:"
        f"{PROMETHEUS_PORT}/metrics"
    )

    while True:
        asyncio.run(
            collect_snmp()
        )

        time.sleep(
            POLL_INTERVAL
        )
