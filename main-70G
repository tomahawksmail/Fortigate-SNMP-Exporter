# PROMETHEUS UPDATE
# ============================================================

def collect_dataCA_FStreet():

    data = asyncio.run(
        run_Fortigate70G()
    )


    if not data:

        print(
            "No SNMP data received"
        )

        return


    # ========================================================
    # FIRMWARE
    # ========================================================

    Firmware_Version.info({
        'version':
            data.get(
                "Firmware Version",
                "unknown"
            )
    })


    # ========================================================
    # BASIC METRICS
    # ========================================================

    set_metric(
        Uptime,
        data,
        "uptime, days"
    )

    set_metric(
        cpu,
        data,
        "cpu, %"
    )

    set_metric(
        memory,
        data,
        "memory, %"
    )

    set_metric(
        Low_Memory_Usage,
        data,
        "Low Memory Usage, %"
    )

    set_metric(
        Disk_Usage,
        data,
        "Disk Usage, MB"
    )

    set_metric(
        Sessions,
        data,
        "Sessions"
    )

    set_metric(
        Active_Sessions,
        data,
        "Active_Sessions"
    )


    # ========================================================
    # FORTIGATE 70G DOES NOT RETURN FAN / PSU VALUES
    #
    # NaN = metric exists, but value is unavailable.
    # Better than reporting a false 0.
    # ========================================================

    FanStatusSpeed_1.set(
        float('nan')
    )

    FanStatusSpeed_2.set(
        float('nan')
    )

    PSUStatus_1.set(
        float('nan')
    )

    PSUStatus_2.set(
        float('nan')
    )


    # ========================================================
    # TEMPERATURES
    # ========================================================

    set_metric(
        TMP1_External_Temperature,
        data,
        "TMP1_External_Temperature"
    )

    set_metric(
        TMP4_ON_DIE_Temperature,
        data,
        "TMP4_ON_DIE_Temperature"
    )

    set_metric(
        CPU_ON_DIE_Temperature,
        data,
        "CPU_ON_DIE_Temperature"
    )

    set_metric(
        BCM_Switch_Temperature,
        data,
        "BCM_Switch_Temperature"
    )

    set_metric(
        B50185_Temperature,
        data,
        "B50185_Temperature"
    )

    set_metric(
        B50210_1_Temperature,
        data,
        "B50210_1_Temperature"
    )


    # This sensor does not exist on this 70G
    B50210_2_Temperature.set(
        float('nan')
    )


